{
  "name": "@vocalstack/payload",
  "version": "0.8.1",
  "description": "VocalStack for Payload CMS: transcribe audio, translate it into other languages and read it aloud, kept in your own database and storage.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/exports/client.d.ts",
      "default": "./dist/exports/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "version": "node scripts/version.mjs && git add src/version.ts",
    "build": "node scripts/version.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/version.mjs && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"test/*.test.*\""
  },
  "peerDependencies": {
    "@payloadcms/ui": "^3.0.0",
    "next": ">=15",
    "payload": "^3.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@payloadcms/ui": "3.80.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "next": "16.2.1",
    "payload": "3.80.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/vocalstack/payload-plugin.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@vocalstack/js-sdk": "2.0.0-alpha.1"
  }
}
